# =============================================================================
# SGV — Variáveis de Ambiente para Docker Compose
# =============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
#   cp .env.example .env
# =============================================================================

# Senha do PostgreSQL (usada pelo db e backend)
DB_PASSWORD=sgv_password_2024

# Configuração do Banco de Dados (propriedades individuais)
DB_HOST=db
DB_PORT=5432
DB_USER=sgv_user
DB_NAME=sgv_viaturas

# URL base da API que o frontend usará
# - Para deploy com proxy reverso (recomendado): /api
# - Para deploy com domínio separado: https://api.seu-dominio.com/api
API_BASE_URL=/api

# Porta onde o frontend será exposto (padrão: 80)
FRONTEND_PORT=80

# Credenciais do PgAdmin (opcional, perfil tools)
PGADMIN_EMAIL=admin@policiacivil.pe.gov.br
PGADMIN_PASSWORD=admin123